[Unit]
Description=slowmo-cam VAR recorder (live view + tournament scoreboard)
Documentation=file:///home/noabauma/src/var/README.md
After=network-online.target
Wants=network-online.target
# never stop retrying: the USB camera can enumerate late after boot,
# and a power-brownout reboot must always come back on its own
StartLimitIntervalSec=0

[Service]
Type=simple
User=noabauma
# priority over desktop processes (Chromium TV view etc.) — the capture
# thread must never wait for a browser tab
Nice=-10
WorkingDirectory=/home/noabauma/src/var
# AR0234 color cam (stable by-id path — /dev/videoN shuffles on boot).
# Its UVC bridge resets to defaults on replug, so re-apply the tuned
# controls before every start ('-' = a missing camera must not block the
# start; slowmo_cam retries the device itself). Manual exposure and focus
# are broken in this bridge's firmware: exposure stays auto (paces
# ~97 fps at 720p in daylight, true 120 needs ~25% more light (lamp) —
# not a promise), focus is the physical lens ring.
ExecStartPre=-/usr/bin/v4l2-ctl -d /dev/v4l/by-id/usb-DCXIN_DCXIN_Camera_01.00.000-video-index0 --set-ctrl auto_exposure=3 --set-ctrl exposure_dynamic_framerate=0 --set-ctrl gain=24 --set-ctrl sharpness=500 --set-ctrl brightness=128 --set-ctrl white_balance_automatic=1 --set-ctrl power_line_frequency=0 --set-ctrl focus_automatic_continuous=0
ExecStart=/home/noabauma/src/var/slowmo_cam --bind 127.0.0.1 --port 8081 --seconds 5 --device /dev/v4l/by-id/usb-DCXIN_DCXIN_Camera_01.00.000-video-index0 --width 1280 --height 720 --fps 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
